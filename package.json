{
  "name": "image-slideshow",
  "version": "1.0.0",
  "description": "Auto-updating image slideshow for DAKboard",
  "main": "server.js",
  "dependencies": {
    "chokidar": "^3.5.0",
    "express": "^4.18.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.0"
  },
  "scripts": {
    "start": "node server.js",
    "preprocess": "node preprocessor.js",
    "dev": "NODE_ENV=development node server.js",
    "dev:preprocess": "NODE_ENV=development node preprocessor.js",
    "test": "node --no-webstorage ./node_modules/.bin/jest --passWithNoTests",
    "test:unit": "node --no-webstorage ./node_modules/.bin/jest --testPathPatterns=tests/unit --passWithNoTests",
    "test:integration": "node --no-webstorage ./node_modules/.bin/jest --testPathPatterns=tests/integration --runInBand --passWithNoTests",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/jest": "^30.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eventsource": "^4.1.0",
    "globals": "^17.0.0",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "setupFilesAfterEnv": [
      "./tests/setup.js"
    ]
  }
}
